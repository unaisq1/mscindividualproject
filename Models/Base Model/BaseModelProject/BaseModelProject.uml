  <Requirements:Requirement xmi:id="_LGyOMGqREfGXLJvyXHhXzw" base_NamedElement="_LGtVsGqREfGXLJvyXHhXzw" id="SecReq1" text="The Autonomous Vehicle's Security System must be able to withstand malicious attacks from unauthorised sources" base_Class="_LGtVsGqREfGXLJvyXHhXzw"/>
  <Requirements:Requirement xmi:id="_4nzQwGqYEfGXLJvyXHhXzw" base_NamedElement="_4nvmYGqYEfGXLJvyXHhXzw" id="SafeReq2" text="The Authonomous Vehicle must maintain safe operation if a single sensor fails" base_Class="_4nvmYGqYEfGXLJvyXHhXzw"/>
