        <ownedComment xmi:type="uml:Comment" xmi:id="_1SfswIqgEfGVwI18gr1osA">
          <body>totalSources: 3&#xD;
minimumVotes: 2</body>
        </ownedComment>
        <packagedElement xmi:type="uml:Class" xmi:id="_Y6BU8IqYEfGVwI18gr1osA" name="Voting System No Redundancy">
