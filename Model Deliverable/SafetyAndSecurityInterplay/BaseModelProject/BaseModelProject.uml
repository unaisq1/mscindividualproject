          </ownedAttribute>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_aMrPoIqYEfGVwI18gr1osA" name="Voting System Redundancy">
          <ownedAttribute xmi:type="uml:Property" xmi:id="_XQHbEIqcEfGVwI18gr1osA" name="totalSources">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
            <defaultValue xmi:type="uml:LiteralInteger" xmi:id="_dhEbwIqcEfGVwI18gr1osA" name="LiteralInteger1" value="1"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_h6ePgIqdEfGVwI18gr1osA" name="minimumVotes">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
            <defaultValue xmi:type="uml:LiteralInteger" xmi:id="_oVB4IIqdEfGVwI18gr1osA" name="LiteralInteger1" value="1"/>
          </ownedAttribute>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_it59IIrVEfGVwI18gr1osA" name="No Redundancy">
          <ownedComment xmi:type="uml:Comment" xmi:id="_EpTSEIt6EfGVwI18gr1osA">
            <body>1 sensor, instead of 3 sensors &#xD;
that can fall on each other &#xD;
if either one fails</body>
          </ownedComment>
          <ownedComment xmi:type="uml:Comment" xmi:id="_x8mhYIuEEfGVwI18gr1osA">
            <body>Use of a dedicated Fusion Processor to prevent other &#xD;
variables of cryptography and processing timings &#xD;
affect evaluation of number of sensors</body>
          </ownedComment>
          <ownedComment xmi:type="uml:Comment" xmi:id="_DeLFQIuGEfGVwI18gr1osA">
            <body>&quot;totalSources&quot; = 1&#xD;
&quot;minimumVotes&quot; = 1&#xD;
Single point of failure, if the one sensor is spoofed or fails, &#xD;
there's no other source to vote for or against, &#xD;
hence a lack of trustworthy protection</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_ZWBhkIryEfGVwI18gr1osA" name="Camera" type="_cgDMEHZCEfG_hu9eze5UeQ" aggregation="composite"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_ZWKrgIryEfGVwI18gr1osA" name="Authentication System" type="_L8hS4HZDEfG_hu9eze5UeQ" aggregation="composite"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_ZWMgsIryEfGVwI18gr1osA" name="Voting System" type="_SCymMHZGEfG_hu9eze5UeQ" aggregation="composite"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_ZWOV4IryEfGVwI18gr1osA" name="FusionProcessorDedicated" type="_dW7M4HZGEfG_hu9eze5UeQ" aggregation="composite"/>
        </packagedElement>
        <packagedElement xmi:type="uml:InformationFlow" xmi:id="_no-0YIrzEfGVwI18gr1osA" informationSource="_ZWBhkIryEfGVwI18gr1osA" informationTarget="_ZWKrgIryEfGVwI18gr1osA"/>
        <packagedElement xmi:type="uml:InformationFlow" xmi:id="_sSlcwIrzEfGVwI18gr1osA" informationSource="_ZWKrgIryEfGVwI18gr1osA _it59IIrVEfGVwI18gr1osA" informationTarget="_ZWMgsIryEfGVwI18gr1osA"/>
