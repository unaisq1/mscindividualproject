      <packagedElement xmi:type="uml:Package" xmi:id="_dtqJsIeQEfGftO8NksHeYw" name="Shared Resources">
        <ownedComment xmi:type="uml:Comment" xmi:id="_l18DIIe2EfGftO8NksHeYw">
          <body>Shared Constraint evaluates to False, due to &#xD;
&quot;cryptoOverhead&quot; &#xD;
and &quot;processingTime&quot; both contributing to total &#xD;
time taken, which is more than the limit provided &#xD;
(50ms)&#xD;
</body>
        </ownedComment>
        <ownedComment xmi:type="uml:Comment" xmi:id="_BGU1sIe4EfGftO8NksHeYw">
          <body>Dedicated Constraint evaluates to False, due to &#xD;
&quot;cryptoOverhead&quot; &#xD;
and &quot;processingTime&quot; both contributing to total &#xD;
time taken, which is more than the limit provided &#xD;
(50ms)&#xD;
</body>
        </ownedComment>
        <packagedElement xmi:type="uml:Class" xmi:id="_9qqqIIeWEfGftO8NksHeYw" name="Fusion Processor Shared">
          <ownedRule xmi:type="uml:Constraint" xmi:id="_mLL2AIeYEfGftO8NksHeYw" name="Shared Constraint">
            <specification xmi:type="uml:OpaqueExpression" xmi:id="_mLfYAIeYEfGftO8NksHeYw" name="constraintSpec">
              <language>OCL</language>
              <body>cryptoOverhead + processingTime &lt;= 50</body>
            </specification>
          </ownedRule>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_GkSEQIeZEfGftO8NksHeYw" name="cryptoOverhead">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
            <defaultValue xmi:type="uml:LiteralInteger" xmi:id="_B9ICMIe1EfGftO8NksHeYw" name="LiteralInteger1" value="15"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_QZvSMIe0EfGftO8NksHeYw" name="processingTime">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
            <defaultValue xmi:type="uml:LiteralInteger" xmi:id="_Uwxj4Ie0EfGftO8NksHeYw" name="LiteralInteger1" value="40"/>
          </ownedAttribute>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_kTQaUIe0EfGftO8NksHeYw" name="Fusion Processor Dedicated">
          <ownedRule xmi:type="uml:Constraint" xmi:id="_kTQaUYe0EfGftO8NksHeYw" name="Constraint3">
            <specification xmi:type="uml:OpaqueExpression" xmi:id="_kTQaUoe0EfGftO8NksHeYw" name="constraintSpec">
              <language>OCL</language>
              <body>true</body>
            </specification>
          </ownedRule>
          <ownedRule xmi:type="uml:Constraint" xmi:id="_SJQ5oIe1EfGftO8NksHeYw" name="Dedicated Constraint">
            <specification xmi:type="uml:OpaqueExpression" xmi:id="_SJSHwIe1EfGftO8NksHeYw" name="constraintSpec">
              <language>OCL</language>
              <body>cryptoOverhead + processingTime &lt;= 50</body>
            </specification>
          </ownedRule>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_kTQaU4e0EfGftO8NksHeYw" name="cryptoOverhead">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
            <defaultValue xmi:type="uml:LiteralInteger" xmi:id="_GlbqEIe1EfGftO8NksHeYw" name="LiteralInteger1"/>
          </ownedAttribute>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_kTQaVIe0EfGftO8NksHeYw" name="processingTime">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
            <defaultValue xmi:type="uml:LiteralInteger" xmi:id="_kTQaVYe0EfGftO8NksHeYw" name="LiteralInteger1" value="40"/>
          </ownedAttribute>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_XtR_AIe5EfGftO8NksHeYw" name="Shared Resources">
          <ownedComment xmi:type="uml:Comment" xmi:id="__cccsIn6EfGVwI18gr1osA">
            <body>&quot;cryptoOverhead&quot; + &quot;processingTime&quot; = 55ms > 50ms deadline&#xD;
Security mechanism (cryptoOverhead) breaks safety timing, therefore, &#xD;
Cross-Layer Composition fails. &#xD;
</body>
          </ownedComment>
          <ownedComment xmi:type="uml:Comment" xmi:id="_qaIJYIoOEfGVwI18gr1osA">
            <body>FusionProcessorShared.cryptoOverhead = 15ms&#xD;
FusionProcessorShared.processingTime = 40ms</body>
          </ownedComment>
