    <packagedElement xmi:type="uml:Package" xmi:id="_K7iHcIeQEfGftO8NksHeYw" name="Architectural Constructs">
      <packagedElement xmi:type="uml:Package" xmi:id="_OebmcIeQEfGftO8NksHeYw" name="Hierarchical Decomposition">
        <ownedComment xmi:type="uml:Comment" xmi:id="_rIl4IIueEfGVwI18gr1osA">
          <body>&quot;totalProcessingTime&quot; = 55ms</body>
        </ownedComment>
        <packagedElement xmi:type="uml:Class" xmi:id="_RcveoIuWEfGVwI18gr1osA" name="AVSystemNonLayered">
          <ownedAttribute xmi:type="uml:Property" xmi:id="_3QprkIudEfGVwI18gr1osA" name="totalProcessingTime">
            <type xmi:type="uml:PrimitiveType" href="pathmap://UML_LIBRARIES/UMLPrimitiveTypes.library.uml#Integer"/>
          </ownedAttribute>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_M2uksIu1EfGVwI18gr1osA" name="Layered">
          <ownedComment xmi:type="uml:Comment" xmi:id="_-0roAIw9EfGVwI18gr1osA">
            <body>Same functionality as a non-layered architectural system, but exposed as multiple separate components that connect with each other, each with interfaces and OCL &#xD;
constraints to define safety and security properties with. The combination of these features make compositional verification possible</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_0HAPQIw7EfGVwI18gr1osA" name="LiDAR" type="_cgDMEHZCEfG_hu9eze5UeQ" aggregation="composite"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_0HFu0Iw7EfGVwI18gr1osA" name="Radar" type="_cgDMEHZCEfG_hu9eze5UeQ" aggregation="composite"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_0HKAQIw7EfGVwI18gr1osA" name="FusionProcessorDedicated" type="_dW7M4HZGEfG_hu9eze5UeQ" aggregation="composite"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_0HNDkIw7EfGVwI18gr1osA" name="Voting System" type="_SCymMHZGEfG_hu9eze5UeQ" aggregation="composite"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_0HQG4Iw7EfGVwI18gr1osA" name="Authentication System" type="_L8hS4HZDEfG_hu9eze5UeQ" aggregation="composite"/>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_0HW0kIw7EfGVwI18gr1osA" name="Camera" type="_cgDMEHZCEfG_hu9eze5UeQ" aggregation="composite"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_P7xqEIu1EfGVwI18gr1osA" name="Block4"/>
        <packagedElement xmi:type="uml:Class" xmi:id="_TNFp0Iu1EfGVwI18gr1osA" name="Non Layered Architecture">
          <ownedComment xmi:type="uml:Comment" xmi:id="_LvVXAIwyEfGVwI18gr1osA">
            <body>Only one property (totalProcessingTime=55ms) is visible. Although the functionality doesn't &#xD;
change from a layered architectural system, there are no internal component boundaries to &#xD;
attach a security property (such as authentication) or a safety property (such as safe fusion &#xD;
timing) to. There are also no components to apply compositional verification to and evaluate &#xD;
whether they make or break specific timings of other components.</body>
          </ownedComment>
          <ownedAttribute xmi:type="uml:Property" xmi:id="_cmI8EIwyEfGVwI18gr1osA" name="AV " aggregation="composite"/>
        </packagedElement>
        <packagedElement xmi:type="uml:Class" xmi:id="_vOCzIIu1EfGVwI18gr1osA" name="Block6">
