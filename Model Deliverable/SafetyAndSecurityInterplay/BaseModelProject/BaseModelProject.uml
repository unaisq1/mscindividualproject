        <specification xmi:type="uml:OpaqueExpression" xmi:id="_pm6X0HZGEfG_hu9eze5UeQ" name="Sensor Constraint 1 (Security Property)">
          <language>OCL</language>
          <body>self.encryptionEnabled = true&#xD;
and self.latency &lt;= 30&#xD;
</body>
        </specification>
      </ownedRule>
      <ownedRule xmi:type="uml:Constraint" xmi:id="_by6mUIYGEfGzIdxIAce5yg" name="Fusion Constraint 1 (Safety and Security Properties)" constrainedElement="_dW7M4HZGEfG_hu9eze5UeQ">
        <specification xmi:type="uml:OpaqueExpression" xmi:id="_bzDwQIYGEfGzIdxIAce5yg" name="constraintSpec">
          <language>OCL</language>
          <body>self.cryptoOverhead + self.processingTime &lt;= 50</body>
        </specification>
      </ownedRule>
